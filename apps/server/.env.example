PORT=5001
NODE_ENV=development

# JWT signing secret for ACCESS tokens — generate a long random string per environment,
# e.g. `openssl rand -base64 48`. Never reuse this value across environments/clients.
SECRET=REPLACE_ME_GENERATE_A_LONG_RANDOM_SECRET

# JWT signing secret for REFRESH tokens — must be a DIFFERENT value from SECRET.
REFRESH_SECRET=REPLACE_ME_GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
REFRESH_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API (e.g. the storefront's URL).
# Leave unset in local development to default to http://localhost:3500.
# Must be set explicitly in production — otherwise cross-origin requests are rejected.
CORS_ORIGIN=http://localhost:3500

# ─── Payments (Mercado Pago, Checkout Pro) ──────────────────────────────────
# Get these from https://www.mercadopago.com.ar/developers — use TEST credentials
# (TEST-...) in every environment except production.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_CURRENCY=ARS
# Public URL of the storefront, used to build the success/failure/pending redirect URLs.
FRONTEND_URL=http://localhost:3500
# Public URL of THIS API, used to build the webhook URL Mercado Pago calls back.
# In local development this must be a public tunnel (e.g. ngrok) — localhost is not
# reachable from Mercado Pago's servers, so webhooks won't arrive without one.
API_BASE_URL=http://localhost:5001
# Override only if the above two don't produce the right webhook URL.
MERCADOPAGO_WEBHOOK_URL=

# Prisma / Postgres connection string (takes precedence over individual vars below)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/react_ecommerce

# TLS for the Postgres connection — the local Docker Postgres from docker-compose.yml does not
# speak TLS, so this defaults to false. Managed/production Postgres (RDS, Supabase, Neon, etc.)
# usually requires it: set DATABASE_SSL=true there.
DATABASE_SSL=false
# Only relevant when DATABASE_SSL=true. Set to false only if your provider uses a self-signed
# certificate your CA store won't validate (common on some managed Postgres offerings).
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Legacy individual DB vars (used if DATABASE_URL is not set)
DATABASE_HOST=localhost
DATABASE_NAME=react_ecommerce
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT=5432

# ─── Seed data (used by `prisma db seed`) ───────────────────────────────────
# Credentials and store identity written when seeding the database.
# Set real, unique passwords per environment — never deploy with these placeholders.
SEED_ADMIN_EMAIL=admin@ecommerce.com
SEED_ADMIN_PASSWORD=REPLACE_ME_STRONG_ADMIN_PASSWORD
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=REPLACE_ME_STRONG_CUSTOMER_PASSWORD
SEED_STORE_NAME="React Ecommerce Store"
SEED_STORE_EMAIL=support@example.com
SEED_CURRENCY=USD
SEED_CURRENCY_SYMBOL=$
